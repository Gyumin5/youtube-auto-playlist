# config.yaml.example — 이 파일을 config.yaml 로 복사해서 채운다.
#
# 채널 하나에 재생목록 하나를 짝짓는다. 그 채널의 새 영상은 거기로만 간다.
# playlist_id 를 안 적은 채널이 있으면 시작할 때 거절한다 — 기본 재생목록으로
# 떨어뜨리면 엉뚱한 곳에 쌓이고, 그걸 나중에 손으로 걷어내야 한다.
#
# channel_id 찾는 법: 채널 주소가 youtube.com/channel/UC... 면 그 UC 로 시작하는 값이
#   그대로 채널 아이디다. 주소가 @핸들이면 그 페이지를 열고 소스에서 "channelId" 를
#   찾거나, 채널의 아무 영상이나 열어 설명 아래 채널 링크를 눌러 주소를 본다.
# playlist_id 찾는 법: 재생목록을 열었을 때 주소의 list= 뒤에 붙는 값이다.
#   보통 PL 로 시작한다. '나중에 볼 동영상'(WL)과 '좋아요 표시한 동영상'(LL)에는
#   공개 API 로 넣을 수 없어서 거절한다.
#
# min_duration_minutes 는 선택이다. 적으면 그보다 짧은 영상은 안 넣는다 — 예고·하이라이트·
#   쇼츠가 섞여 올라오는 채널에서 본편만 고르는 데 쓴다. 적은 채널마다 회차에 조회 1단위가
#   더 든다(길이는 영상 목록에 안 들어 있어서 따로 묻는다). 거른 영상은 기록해 두므로
#   다음 회차에 다시 묻지 않는다.

channels:
  - name: 예시 채널 하나
    channel_id: UC_x5XG1OV2P6uZZ5FSM9Ttw
    playlist_id: PLOU2XLYxmsIKpaV8h0AGE05so0fAwwfTw

  - name: 예시 채널 둘
    channel_id: UCBJycsmduvYEL83R_U4JriQ
    playlist_id: PLKcKU7ThUUvX2KBAJ3NsQZSTEI54V9hHk
    min_duration_minutes: 40   # 40분 넘는 본편만 넣는다

# 얼마나 자주 보나 (초). 최소 60.
# 조회도 할당량을 쓰므로 너무 짧게 잡으면 시작할 때 거절하고 쓸 수 있는 주기를 알려 준다.
check_interval_seconds: 3600

# 하루 할당량을 다 쓴 회차 뒤에는 이만큼 쉰다 (초). 할당량은 태평양 시간 자정에 초기화된다.
quota_backoff_seconds: 3600

# 처음 보는 채널의 첫 회차는 넣지 않고 기록만 한다.
# 한 번에 최근 열다섯 개를 받으므로, 켜 두지 않으면 첫 회차에 재생목록이 과거 영상으로 덮인다.
seed_on_first_run: true

# 한 회차에 채널 하나당 최대 몇 개까지 넣나. 나머지는 다음 회차로 넘어간다.
max_videos_per_channel_per_run: 10

# 조회 하나를 기다리는 제한시간 (초).
request_timeout_seconds: 20
