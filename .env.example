# .env.example — 이 파일을 .env 로 복사한다. 비워 두면 아래 기본값이 쓰인다.
#
# 여기 적는 것은 파일 경로뿐이다. 채널·재생목록·주기는 config.yaml 이 가진다.
# 상대경로는 이 프로젝트 폴더 기준이다.
#
# .env, client_secret.json, token.json 은 저장소에 올리지 않는다 (.gitignore 에 있다).

# 구글 클라우드 콘솔에서 받은 데스크톱 앱 자격 파일 (README 1번 참고)
YTAP_CLIENT_SECRET_FILE=client_secret.json

# 로그인 뒤 저장되는 토큰. 지우면 다시 로그인해야 한다.
YTAP_TOKEN_FILE=token.json

# 이미 넣은 영상을 적어 두는 곳. 지우면 중복 방지 기록이 사라진다.
YTAP_DB_FILE=state/added_videos.sqlite3

# 실행 기록
YTAP_LOG_FILE=youtube_auto_add.log

# 설정 파일 경로를 바꾸고 싶을 때만 (기본: config.yaml)
# YTAP_CONFIG_FILE=config.yaml
